[Unit]
Description=UART Monitor Daemon - Background serial port logger
After=local-fs.target

[Service]
Type=notify
ExecStart=%h/.local/bin/uart-monitor monitor --systemd --proxy
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/bin/sh -c 'logger -t uart-monitor-stop "result=$SERVICE_RESULT code=$EXIT_CODE status=$EXIT_STATUS"; ps -eo pid,ppid,user,cmd 2>/dev/null | grep -E "systemctl.*uart-monitor" | grep -v grep | logger -t uart-monitor-stop; true'
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=3
KillMode=process
Environment="HOME=%h"
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
